;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GNGJ"
run/main_scene="uid://bplgqa3i45unb"
config/auto_accept_quit=false
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"

